# Copy to .env.local for local development.
# Leave unset to use guest mode (browser localStorage only).

# JWT_SECRET=dev-only-change-me-to-a-long-random-string
# DATABASE_URL=postgresql://user:pass@host:5432/papertrading?sslmode=require
# AUTH_COOKIE_SECURE=false

# Cyber Essentials-oriented auth controls (match production defaults when testing):
# ALLOW_PUBLIC_SIGNUP=true
# SIGNUP_INVITE_CODE=your-shared-invite
